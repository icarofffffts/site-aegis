[Unit]
Description=Aegis Site - Vite Preview Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/aegis-site
ExecStart=/usr/bin/npx vite preview --port 3002 --host 0.0.0.0
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
